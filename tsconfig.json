{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "allowJs": true,
    "types": ["vite/client", "react", "node"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Non-relative imports resolve against src/, then convex/ ("_generated/server",
    // "lib/access" from the Convex functions); convex/tsconfig.json lists the same two in the
    // same order, so a name means the same file to tsc, Vite, vitest and Convex's bundler.
    // The generated Convex API is "convex/_generated/api": the more specific pattern wins,
    // and the convex package has no _generated subpath, so "convex/react" still reaches it.
    "paths": {
      "convex/_generated/*": ["./convex/_generated/*"],
      "*": ["./src/*", "./convex/*"]
    },

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  "exclude": ["dist", "node_modules"]
}
